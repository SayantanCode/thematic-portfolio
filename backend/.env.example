NODE_ENV=development
PORT=3000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thematic-portfolio

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_PRE_AUTH_EXPIRES_IN=5m

ADMIN_USERNAME=change-me

# bcrypt hash of your chosen admin password — never the plaintext.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# NOTE: no TOTP secret goes here anymore — it's generated by the server and
# stored in MongoDB the first time you log in and scan the QR code shown on
# the admin login page (features/auth/services/auth.service.js).

CORS_ORIGIN=http://localhost:5173

# Cloudinary — Console (cloudinary.com) -> gear icon (Settings) -> Access Keys
# tab -> "Generate New API Key" gives you a fresh key/secret pair under your
# existing cloud without touching any keys you already use elsewhere. Cloud
# name is shown at the top of the Dashboard page. Uploads always go through
# this backend (features/media), never directly from the browser, so the API
# secret never reaches the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
